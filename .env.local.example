# Convex
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# WorkOS AuthKit
WORKOS_CLIENT_ID=client_your_client_id
WORKOS_API_KEY=sk_test_your_api_key
WORKOS_COOKIE_PASSWORD=replace-with-output-from-openssl-rand-base64-32
# Fallback callback URL. Runtime sign-in uses the current request origin, so register every local port you use in WorkOS.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Optional Convex deployment seed controls. Set these with `npx convex env set`, not as public browser env.
TAPCHECK_ENABLE_SEED_DATA=false
TAPCHECK_SEED_TEACHER_EMAIL=teacher@example.com
TAPCHECK_SEED_TEACHER_NAME=Seed Teacher
TAPCHECK_SEED_STUDENT_EMAIL=student@example.edu
TAPCHECK_SEED_STUDENT_ID=9001
TAPCHECK_SEED_STUDENT_NAME=Smoke Test Student
TAPCHECK_SEED_ROSTER_NAME=Tapcheck QR Smoke Test
