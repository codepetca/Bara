# Convex development deployment
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WorkOS AuthKit Bara application inside the shared Codepet Platform environment.
# The access token's client_id must match this application-specific client ID.
WORKOS_CLIENT_ID=client_your_client_id
WORKOS_API_KEY=sk_test_your_api_key
WORKOS_COOKIE_PASSWORD=replace_with_at_least_32_random_characters
# Keep application sessions distinct when Pika and Bara run on different localhost ports.
WORKOS_COOKIE_NAME=bara-wos-session
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Bara-owned delivery for WorkOS Magic Auth events. Keep disabled until the
# signed webhook, Brevo template, and one-message canaries pass in the matching
# WorkOS/Convex environment. PIKA_WORKOS_CLIENT_ID is routing metadata only;
# never use Pika credentials or sessions in Bara.
WORKOS_MAGIC_AUTH_BREVO_DELIVERY=false
WORKOS_MAGIC_AUTH_WEBHOOK_SECRET=
PIKA_WORKOS_CLIENT_ID=client_your_pika_client_id
BREVO_API_KEY=
BREVO_TEMPLATE_ID=
BREVO_FROM_EMAIL=noreply@notify.codepet.ca
BREVO_FROM_NAME=Bara

# Retired cross-application browser handoff. Keep disabled: native Pika
# attendance authenticates in Pika and calls Bara server-to-server.
PIKA_BARA_AUTH_HANDOFF=false

# Pika server-to-server attendance adapter. Keep disabled until a dedicated,
# environment-specific installation reference and 32+ character secret exist
# in both Pika and the matching Convex deployment. The signed smoke-only route
# may verify both deployed credential directions while this flag remains false.
PIKA_ATTENDANCE_INTEGRATION=false
PIKA_INTEGRATION_REF=
PIKA_INTEGRATION_SECRET=
# Exact Pika event-ingress URL and a separate reverse-direction secret.
PIKA_EVENT_DELIVERY_URL=
PIKA_EVENT_DELIVERY_SECRET=

# CI only: do not add this to the shared local .env.local. Vercel Preview uses
# a preview-scoped key; Vercel Production uses a production-scoped key.
# CONVEX_DEPLOY_KEY=
